# Copy to `.env.local` for Next.js. Never commit real keys.
# These values come from a REMOTE Supabase project. There is no local/Docker database.

# Dev project API URL (Settings → API). Not localhost.
NEXT_PUBLIC_SUPABASE_URL=https://bogqhfsdzvnqxdbsylho.supabase.co

# Dev project anon key. Safe to expose in the browser; RLS is the access control.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJvZ3FoZnNkenZucXhkYnN5bGhvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk1ODE3NzcsImV4cCI6MjEwNTE1Nzc3N30._OsWjju4g6IT_68ks9F3HIk5kb_GF_FWTCisdJEVa04

# Server-only. Never prefix with NEXT_PUBLIC_. Used by /api/v1 command routes.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJvZ3FoZnNkenZucXhkYnN5bGhvIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4OTU4MTc3NywiZXhwIjoyMTA1MTU3Nzc3fQ.FvtyIXTBALWJh3VBKi_ic_ZtxeWvdLOuIV8-PecGzKQ

# Server-only. Direct Postgres connection string (Settings → Database).
# Used by `supabase db push` / `supabase test db --db-url` against the linked project.
# Never prefix with NEXT_PUBLIC_. Never ship this to the client bundle.
SUPABASE_DB_URL=postgresql://postgres:ob6OHMdc66KzmLg9@db.bogqhfsdzvnqxdbsylho.supabase.co:5432/postgres

# Server-only. gsc_api_executor role URI for commands.* (not the API keys).
# After ALTER ROLE gsc_api_executor LOGIN PASSWORD '...', paste that URI here.
# Used by src/server/executor.ts. Never prefix with NEXT_PUBLIC_.
COMMANDS_DATABASE_URL=postgresql://gsc_api_executor:choose-a-strong-password-here@db.bogqhfsdzvnqxdbsylho.supabase.co:5432/postgres

# Optional. Server-only Resend key for post-commit invite mail. Never NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Server-only ExchangeRate-API key for CAT-04 USD snapshots. Never NEXT_PUBLIC_.
# Get a key from https://www.exchangerate-api.com/ and paste it here.
# Without it, original currencies stay visible and conversion is unavailable.
EXCHANGE_RATE_API_KEY=

# Server-only AES key material for identity.phone_cipher / whatsapp_cipher.
# Use a long random string in production. Never ship this to the client bundle.
GSC_CONTACT_ENCRYPTION_KEY=

# Server-only Daily key for SES-07 rooms and meeting tokens. Never NEXT_PUBLIC_.
# Leave unset to use the sandbox adapter. Sandbox does not prove real video.
DAILY_API_KEY=
GSC_VIDEO_PROVIDER=sandbox

# Server-only. Recording and AI stay off until Prompt 23 and an owner flag.
# The adapter cannot prove pause-before-admit, so recording never starts.
GSC_FEATURE_RECORDING_AI=0

# Parked leftover modules (essays, recommendation letters, interviews, offers, billing).
# Keep at 0. Do not extend those pages. Set to 1 only to inspect parked UI.
GSC_FEATURE_PARKED_MODULES=0
