{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist-test",
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/domain/**/*.ts",
    "src/types/index.ts",
    "src/server/errors.ts",
    "src/server/errors.test.ts",
    "src/server/http/body.ts",
    "src/server/http/envelope.ts",
    "src/server/http/headers.ts",
    "src/server/http/headers.test.ts"
  ]
}
